{
  "name": "beauty-trainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply beauty-trainer --local",
    "db:seed": "tsx scripts/seed.ts && wrangler d1 execute beauty-trainer --local --file=data/seed.sql",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "playwright test",
    "db:e2e": "wrangler d1 migrations apply beauty-trainer --local --persist-to .wrangler/e2e-accounts && tsx scripts/seed.ts && wrangler d1 execute beauty-trainer --local --persist-to .wrangler/e2e-accounts --file=data/seed.sql && wrangler d1 execute beauty-trainer --local --persist-to .wrangler/e2e-accounts --file=tests/e2e/legacy-account.sql",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:generate": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.30.0",
    "globals": "^16.2.0",
    "prettier": "^3.9.6",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.20.0"
  }
}
